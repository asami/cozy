# COMPOSITE-STATEMACHINE

## OrderPaymentShipment

### CONSTITUENT

#### payment

state-machine = PaymentLifecycle
subject = payment
subject-type = PaymentCommand

#### shipment

state-machine = ShipmentLifecycle
subject = shipment
subject-type = ShipmentCommand

### STATE

#### AwaitingPayment

#### AwaitingShipment

#### AuthorizedPayment

#### AuthorizedShipment

### DERIVATION

#### awaiting-payment

state = AwaitingPayment
when = payment.Awaiting, shipment.Waiting

#### awaiting-shipment

state = AwaitingShipment
when = payment.Awaiting, shipment.Reserved

#### authorized-payment

state = AuthorizedPayment
when = payment.Authorized, shipment.Waiting

#### authorized-shipment

state = AuthorizedShipment
when = payment.Authorized, shipment.Reserved

### INITIAL

payment.Awaiting, shipment.Waiting

### ACTION

#### record-authorization

kind = OPERATION
operation = PaymentService.recordAuthorization
input = payment.subject
effect = LOCAL
transaction = REQUIRED
idempotency = REQUIRED
idempotency-key = record-authorization

#### reserve-shipment

kind = OPERATION
operation = ShipmentService.reserveShipment
input = shipment.subject
effect = EXTERNAL
transaction = OUTSIDE_UNIT_OF_WORK
idempotency = REQUIRED
idempotency-key = reserve-shipment
compensation-handler = release-shipment

#### release-shipment

kind = OPERATION
operation = ShipmentService.releaseShipment
input = shipment.subject
effect = EXTERNAL
transaction = OUTSIDE_UNIT_OF_WORK
idempotency = REQUIRED
idempotency-key = release-shipment

### CONSTITUENT-ACTION

#### payment-authorization-exit

role = payment
from = Awaiting
to = Authorized
on = authorized
placement = exit
action = record-authorization

#### payment-authorization-transition

role = payment
from = Awaiting
to = Authorized
on = authorized
placement = transition
action = record-authorization

#### payment-authorization-entry

role = payment
from = Awaiting
to = Authorized
on = authorized
placement = entry
action = record-authorization

### DERIVED-ACTION

#### reserve-shipment

from = AwaitingPayment
to = AwaitingShipment
action = reserve-shipment

