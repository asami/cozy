# WORKFLOW

## InvocationControlledWorkflow

version = workflow-invocation-policy-v2

### COMPOSITE-STATEMACHINE

#### CONSTITUENT

##### payment

state-machine = PaymentLifecycle
subject = payment
subject-type = PaymentCommand

#### STATE

##### Pending

##### Complete

#### DERIVATION

##### pending

state = Pending
when = payment.Awaiting

##### complete

state = Complete
when = payment.Paid

#### ACTION

##### capture-payment

kind = OPERATION
operation = capturePayment
input = payment.subject

##### check-payment

kind = OPERATION
operation = capturePayment
input = payment.subject

### REQUIRED-OPERATION

#### capture-payment-capability

action = capture-payment

#### check-payment-capability

action = check-payment

### INVOCATION-POLICY

#### capture-control

action = capture-payment
maximum-attempts = 3
fixed-retry-delay-millis = 250
execution-timeout-millis = 30000

#### check-control

participant = check-payment-capability
execution-timeout-millis = 9223372036854775807

